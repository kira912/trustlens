# ==========================================
# 🌐 CONFIGURATION DU FRONTEND (Vercel)
# ==========================================
# URL de l'API NestJS hébergée sur Render (ex: https://trustlens-api.onrender.com)
VITE_API_URL="https://votre-api-nest.onrender.com"

# ==========================================
# 🗄️ CONFIGURATION DU BACKEND (Render)
# ==========================================
# URL de connexion PostgreSQL (à renseigner dans le dashboard Render)
POSTGRES_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Alternative supportée :
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
